# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...

# Main model for coaching, feedback and JD analysis (decided: Sonnet 5.5)
DEFAULT_MODEL=anthropic/claude-sonnet-5.5
# Cheap model for the LLM guard classifier (runs on every request)
GUARD_MODEL=anthropic/claude-haiku-4.5

# Guard behaviour
LLM_GUARD_ENABLED=true
# If the guard classifier itself errors: true = block the request, false = allow and log a warning
GUARD_FAIL_CLOSED=false

# Soft spend limit per Streamlit session; the UI warns when exceeded
MAX_SESSION_COST_USD=2.0
