# Copy to .streamlit/secrets.toml (gitignored) to try sign-in locally, or paste into the
# Streamlit Community Cloud "Secrets" box. Top-level keys are exported as environment
# variables at startup, so every setting from .env.example works here too.

OPENROUTER_API_KEY = "sk-or-v1-..."
APP_ENV = "prod"                     # forces GUARD_FAIL_CLOSED=true and requires sign-in
ALLOWED_EMAILS = "*"                 # any Google account (public demo); or "you@x.com,other@y.io"
DATABASE_URL = "postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
MAX_DAILY_COST_USD = 2.0            # per user per day
MAX_DAILY_COST_TOTAL_USD = 20.0     # everyone per day

# Streamlit's built-in OIDC login (st.login). Create a "Web application" OAuth client in
# Google Cloud Console and add redirect_uri to its authorised redirect URIs.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # prod: https://<app>.streamlit.app/oauth2callback
cookie_secret = "replace-with-a-long-random-string"      # e.g. python -c "import secrets; print(secrets.token_hex(32))"
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
